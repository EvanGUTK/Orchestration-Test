{
  "name": "2048-infinite",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only 2048 Infinite: accounts, saves, ranked challenges, bots, duels, replays.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/engine",
    "packages/database",
    "packages/bots",
    "packages/competition",
    "apps/server",
    "apps/web",
    "tests"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b tsconfig.build.json && npm run build -w @g2048/web",
    "start": "node apps/server/dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --project unit --project web --project acceptance",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --config tests/acceptance/playwright.config.ts",
    "test:performance": "node --conditions=source --import tsx tests/performance/run.ts",
    "db:migrate": "node --conditions=source --import tsx apps/server/src/cli.ts migrate",
    "db:backup": "node --conditions=source --import tsx apps/server/src/cli.ts backup",
    "db:restore": "node --conditions=source --import tsx apps/server/src/cli.ts restore",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
